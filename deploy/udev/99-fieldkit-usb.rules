# Fieldkit: auto-mount removable USB filesystems so the Files page's `usb`
# library (copy-to-USB) can see an inserted stick. Mounting itself is performed
# by the templated systemd unit (never directly from udev, which runs in a
# restricted namespace); this rule only asks systemd to start it.
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}=="vfat|exfat|ext4|ext3", TAG+="systemd", ENV{SYSTEMD_WANTS}+="fieldkit-usb-mount@%k.service"
