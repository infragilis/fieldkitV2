[Unit]
Description=Start a Fieldkit server content sync
# The timer waits 10 minutes after boot, so the sync does not need to gate on
# network-online (which is masked in the golden image); the local curl call has
# its own timeout.
After=fieldkit-web.service
Requires=fieldkit-web.service

[Service]
Type=oneshot
User=service
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 15 --request POST http://127.0.0.1:8000/api/server-sync/sync?trigger=scheduled
StandardOutput=null
TimeoutStartSec=20
