[Unit]
Description=Fieldkit Web Service
# Bind loopback only; nginx fronts it. No need to wait for DHCP/online.
After=network.target

[Service]
Type=simple
User=service
WorkingDirectory=/opt/fieldkit
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fieldkit/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
