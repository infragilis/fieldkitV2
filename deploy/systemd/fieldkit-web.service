[Unit]
Description=Fieldkit Web Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=service
WorkingDirectory=/opt/fieldkit
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fieldkit/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
