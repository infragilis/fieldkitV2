[Unit]
Description=Fieldkit Startup Network Apply
# Run AFTER the system is up so a slow/failed AP bring-up can never block the
# console, sshd, nginx, or the web UI. Failure is non-fatal.
After=NetworkManager.service multi-user.target
Wants=NetworkManager.service

[Service]
Type=oneshot
TimeoutStartSec=120
ExecStart=-/bin/bash /opt/fieldkit/scripts/apply_startup_network_mode.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
